rules_version = '2';

// Règles de sécurité Cloud Firestore : à copier dans la console Firebase
// (Firestore Database → onglet « Règles » → Publier).
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque éleveur ne peut lire et modifier que ses propres données :
    // users/{uid}, ses bandes users/{uid}/flocks/... et tout ce qu'elles contiennent
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
